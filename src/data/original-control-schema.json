  "interactionRules": [
    {
      "rule": "JPEG amount update",
      "paths": [
        "jpegGlitch.blockShift.amount",
        "jpegGlitch.channelSwap.amount",
        "jpegGlitch.scanlineOffset.amount",
        "jpegGlitch.blockScramble.amount",
        "jpegGlitch.interlaceCorruption.amount"
      ],
      "onChange": "set amount to value; if value > 0, set sibling enabled=true; zero leaves sibling enabled unchanged",
      "processingGate": "outer jpegGlitch.enabled && subeffect.enabled && subeffect.amount > 0",
      "sourceRange": [
        438902,
        442950
      ]
    },
    {
      "rule": "Outer enabled gates",
      "detail": "All six effects require outer enabled for execution. Their numeric controls and dropdowns disable while outer enabled=false. Epsilon Radius Compensation lacks disabled prop in original UI and remains editable."
    },
    {
      "rule": "Parameter edit does not enable effect",
      "detail": "Except the five nested JPEG flags, changing a numeric value does not implicitly enable its outer effect."
    },
    {
      "rule": "Temporal still time",
      "detail": "Temporal Variation executes only when state.time is defined. Still images ordinarily pass undefined, not zero; zero is a real timeline position."
    },
    {
      "rule": "Animation UI gate",
      "detail": "Property paths named in animationPaths disable manual numeric edits. Pure effect helpers interpolate stored values; halftone dotGain/gcr animation values use stored fractional units."
    },
    {
      "rule": "Slider lock",
      "detail": "Original ut/Qs disable input when locked, disabled, or animationLocked. Locked is also used to exclude randomization; it is more than a shuffle-only flag."
    },
    {
      "rule": "Numeric input semantics",
      "detail": "Numeric inputs clamp min/max, do not explicitly quantize entered decimals to step. Range controls and dial pointer/keyboard interactions apply step."
    },
    {
      "rule": "Latent default keys",
      "detail": "postProcessing defaults contain denoise, grain, vignette but original Gx exposes no controls for them. Preserve them in payloads; do not invent UI controls."
    },
    {
      "rule": "Misleading original tooltips",
      "detail": "Epsilon threshold actual max is100 although title says255; intensity actual max is1000 although title says500. Use actual min/max props."
    },
    {
      "rule": "Dither feature flags",
      "detail": "DPI disabled when supportsDpiScale=false. Threshold visible only supportsLuminanceThreshold. Palette controls disabled when supportsColorPalettes=false; depth disabled when supportsColorDepth=false. Numeric algorithm controls use current controlValues[id] ?? defaultValue."
    }
  ]
